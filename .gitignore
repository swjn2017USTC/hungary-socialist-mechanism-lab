# environments / tool caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# local run outputs (manifests stay local; compact summaries may be copied on purpose)
outputs/
.omp/config.yml.lock

# raw / private / large data: never commit microdata or large tables
data/raw/
data/observed/
data/reconstructed/
data/assumptions/
data/private/
*.duckdb
*.duckdb.wal
*.parquet
